{
  "$schema": "./admin-cms.schema.json",
  "version": 2,
  "project": {
    "name": "MyNails",
    "slug": "mynails"
  },
  "forms": [
    {
      "slug": "waitlist",
      "name": "Waitlist",
      "status": "published",
      "successMessage": "You are on the list. We will write once, when the sets are ready.",
      "fields": [
        {
          "name": "email",
          "label": "Email address",
          "type": "email",
          "required": true,
          "placeholder": "you@example.com"
        },
        {
          "name": "name",
          "label": "Your name",
          "type": "text",
          "width": "half"
        },
        {
          "name": "set",
          "label": "The set you are waiting for",
          "type": "select",
          "width": "half",
          "options": [
            { "value": "", "label": "No preference" },
            { "value": "lily-blanc", "label": "Lily Blanc" },
            { "value": "orchid-veil", "label": "Orchid Veil" },
            { "value": "matcha-latte", "label": "Matcha Latte" },
            { "value": "cherry-gloss", "label": "Cherry Gloss" },
            { "value": "etoile", "label": "Étoile" },
            { "value": "bunny-cream", "label": "Bunny Cream" },
            { "value": "amour", "label": "Amour" }
          ]
        }
      ],
      "site": {
        "submitLabel": "Join",
        "spamProtection": "honeypot",
        "retentionDays": 0
      }
    },
    {
      "slug": "custom-set",
      "name": "Custom set enquiry",
      "status": "published",
      "successMessage": "Thanks — we will come back to you with a sketch and a lead time.",
      "fields": [
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true
        },
        {
          "name": "occasion",
          "label": "What it is for",
          "type": "select",
          "options": [
            { "value": "wedding", "label": "A wedding" },
            { "value": "shoot", "label": "A shoot" },
            { "value": "gift", "label": "A gift" },
            { "value": "other", "label": "Something else" }
          ]
        },
        {
          "name": "detail",
          "label": "Tell us more",
          "type": "textarea",
          "showWhen": {
            "field": "occasion",
            "is": "equal",
            "value": "other"
          }
        },
        {
          "name": "date",
          "label": "When you need them",
          "type": "date",
          "width": "half"
        }
      ],
      "site": {
        "submitLabel": "Send enquiry",
        "spamProtection": "honeypot",
        "retentionDays": 0
      }
    },
    {
      "slug": "sizing",
      "name": "Sizing kit",
      "status": "published",
      "fields": [
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "required": true
        }
      ],
      "successMessage": "The sizing guide is on its way."
    },
    {
      "slug": "delivery",
      "name": "Where to send your set",
      "status": "published",
      "fields": [
        {
          "name": "full_name",
          "label": "Full name",
          "type": "text",
          "required": true
        },
        {
          "name": "address",
          "label": "Address",
          "type": "textarea",
          "required": true
        },
        {
          "name": "shape",
          "label": "Preferred shape",
          "type": "select",
          "options": [
            { "value": "almond-medium", "label": "Almond · Medium" },
            { "value": "almond-long", "label": "Almond · Long" },
            { "value": "almond-short", "label": "Almond · Short" }
          ]
        }
      ]
    },
    {
      "slug": "contact",
      "name": "Write to the studio",
      "status": "published",
      "fields": [
        {
          "name": "email",
          "label": "Your email",
          "type": "email",
          "required": true,
          "fill": {
            "from": "user.email",
            "when": "signed-in",
            "display": "hidden"
          }
        },
        {
          "name": "subject",
          "label": "Subject",
          "type": "text",
          "required": true
        },
        {
          "name": "message",
          "label": "Message",
          "type": "textarea",
          "required": true
        }
      ],
      "successMessage": "Thank you — it is with the studio."
    },
    {
      "slug": "your-details",
      "name": "Your details",
      "status": "published",
      "fields": [
        {
          "name": "first_name",
          "label": "First name",
          "type": "text",
          "required": true
        },
        {
          "name": "last_name",
          "label": "Last name",
          "type": "text",
          "required": true
        },
        {
          "name": "email",
          "label": "Email",
          "type": "email",
          "fill": {
            "from": "user.email",
            "when": "signed-in",
            "display": "locked"
          }
        }
      ]
    }
  ]
}
